{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plan2agent.local/schemas/run.schema.json",
  "title": "Plan2Agent Agent Run",
  "type": "object",
  "required": [
    "schema_version",
    "runId",
    "projectId",
    "taskId",
    "taskTitle",
    "iterationId",
    "sourceLayout",
    "taskGraphRef",
    "sourceSpecRef",
    "agentTool",
    "workspaceRef",
    "workspacePath",
    "isolation",
    "status",
    "startedAt",
    "updatedAt",
    "finishedAt",
    "changedFiles",
    "verification",
    "notes"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "enum": [
        "p2a.run.v1",
        "p2a.run.v2"
      ]
    },
    "runId": {
      "type": "string",
      "pattern": "^run-[A-Za-z0-9._-]+$"
    },
    "projectId": {
      "type": "string",
      "minLength": 1
    },
    "taskId": {
      "type": "string",
      "pattern": "^task-[0-9]+$"
    },
    "taskTitle": {
      "type": "string",
      "minLength": 1
    },
    "iterationId": {
      "type": [
        "string",
        "null"
      ]
    },
    "sourceLayout": {
      "type": "string",
      "enum": [
        "iteration",
        "maintenance",
        "handoff",
        "graph"
      ]
    },
    "taskGraphRef": {
      "type": "string",
      "minLength": 1
    },
    "sourceSpecRef": {
      "type": "string",
      "minLength": 1
    },
    "runKind": {
      "type": "string",
      "enum": [
        "final_visual_review",
        "final_acceptance_review"
      ]
    },
    "taskContractSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "executionEnvelope": {
      "type": "object",
      "required": [
        "objective",
        "sourceGateRefs",
        "scope",
        "mustPreserve",
        "nonGoals",
        "acceptance",
        "verification",
        "executionAuthority"
      ],
      "additionalProperties": false,
      "properties": {
        "objective": {
          "type": "string",
          "minLength": 1
        },
        "sourceGateRefs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["path", "sha256"],
            "additionalProperties": false,
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
            }
          }
        },
        "scope": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "mustPreserve": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "nonGoals": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "acceptance": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "verification": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "executionAuthority": {
          "type": "object",
          "required": ["mayChoose", "mustReturnToGate"],
          "additionalProperties": false,
          "properties": {
            "mayChoose": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            },
            "mustReturnToGate": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            }
          }
        },
        "visualContract": {
          "type": "object",
          "required": [
            "experienceSpecRef",
            "experienceSpecSha256"
          ],
          "additionalProperties": false,
          "properties": {
            "experienceSpecRef": { "type": "string", "minLength": 1 },
            "experienceSpecSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "prototypeManifestRef": { "type": "string", "minLength": 1 },
            "prototypeManifestSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "screens": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "screenId",
                  "route",
                  "entryPoints",
                  "states",
                  "responsiveRules",
                  "accessibilityRequirements"
                ],
                "additionalProperties": false,
                "properties": {
                  "screenId": { "type": "string", "pattern": "^SCREEN-[0-9]+$" },
                  "route": { "type": ["string", "null"] },
                  "entryPoints": {
                    "type": "array",
                    "minItems": 1,
                    "items": { "type": "string", "minLength": 1 }
                  },
                  "states": {
                    "type": "array",
                    "minItems": 1,
                    "items": { "type": "string", "minLength": 1 }
                  },
                  "responsiveRules": {
                    "type": "array",
                    "minItems": 1,
                    "items": { "type": "string", "minLength": 1 }
                  },
                  "accessibilityRequirements": {
                    "type": "array",
                    "minItems": 1,
                    "items": { "type": "string", "minLength": 1 }
                  }
                }
              }
            },
            "viewports": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["name", "width", "height"],
                "additionalProperties": false,
                "properties": {
                  "name": { "type": "string", "minLength": 1 },
                  "width": { "type": "integer", "minimum": 1 },
                  "height": { "type": "integer", "minimum": 1 }
                }
              }
            },
            "accessibilityStandard": { "type": "string", "minLength": 1 },
            "visualInvariants": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "executionEnvelopeSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "mode": {
      "type": "string",
      "enum": [
        "direct",
        "planned",
        "orchestrated"
      ]
    },
    "selectionRationale": {
      "type": "string",
      "minLength": 1
    },
    "milestones": {
      "type": "array",
      "minItems": 2,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": [
          "id",
          "outcome",
          "verification",
          "status",
          "verifiedAt"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^milestone-[A-Za-z0-9._-]+$"
          },
          "outcome": {
            "type": "string",
            "minLength": 1
          },
          "verification": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "verified"
            ]
          },
          "verifiedAt": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "agentTool": {
      "type": "string",
      "minLength": 1
    },
    "workspaceRef": {
      "type": "string",
      "minLength": 1
    },
    "workspacePath": {
      "type": "string",
      "minLength": 1
    },
    "workspaceRevisionSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "visualReviewEvidenceSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "acceptanceReviewEvidenceSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "monitorVerdictEvidenceSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "monitorGate": {
      "type": "object",
      "required": [
        "required",
        "policy",
        "contractSha256"
      ],
      "additionalProperties": false,
      "properties": {
        "required": {
          "const": true
        },
        "policy": {
          "const": "p2a.monitor_gate.rules.v1"
        },
        "contractSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "isolation": {
      "type": "object",
      "required": [
        "mode",
        "branch",
        "worktree",
        "baseRef",
        "created",
        "createCommand",
        "createExitCode",
        "createOutputTail"
      ],
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "none",
            "branch",
            "worktree"
          ]
        },
        "branch": {
          "type": [
            "string",
            "null"
          ]
        },
        "worktree": {
          "type": [
            "string",
            "null"
          ]
        },
        "baseRef": {
          "type": [
            "string",
            "null"
          ]
        },
        "created": {
          "type": "boolean"
        },
        "createCommand": {
          "type": [
            "string",
            "null"
          ]
        },
        "createExitCode": {
          "type": [
            "integer",
            "null"
          ]
        },
        "createOutputTail": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "started",
        "finished",
        "failed",
        "blocked"
      ]
    },
    "startedAt": {
      "type": "string",
      "minLength": 1
    },
    "updatedAt": {
      "type": "string",
      "minLength": 1
    },
    "finishedAt": {
      "type": [
        "string",
        "null"
      ]
    },
    "changedFiles": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "verification": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type",
          "command",
          "status",
          "exitCode",
          "durationMs",
          "startedAt",
          "finishedAt",
          "stdoutTail",
          "stderrTail",
          "source"
        ],
        "additionalProperties": false,
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "test",
              "lint",
              "typecheck",
              "custom"
            ]
          },
          "command": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "passed",
              "failed",
              "skipped",
              "not_run",
              "unavailable"
            ]
          },
          "exitCode": {
            "type": [
              "integer",
              "null"
            ]
          },
          "durationMs": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "startedAt": {
            "type": [
              "string",
              "null"
            ]
          },
          "finishedAt": {
            "type": [
              "string",
              "null"
            ]
          },
          "stdoutTail": {
            "type": [
              "string",
              "null"
            ]
          },
          "stderrTail": {
            "type": [
              "string",
              "null"
            ]
          },
          "source": {
            "type": "string",
            "enum": [
              "config",
              "command",
              "manual"
            ]
          },
          "milestoneId": {
            "type": "string",
            "pattern": "^milestone-[A-Za-z0-9._-]+$"
          },
          "failureReason": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "failureHint": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "originalCommand": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "normalizedCommand": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          }
        }
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "usage": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "recordedAt",
          "source",
          "modelProfile",
          "inputTokens",
          "outputTokens",
          "totalTokens"
        ],
        "additionalProperties": false,
        "properties": {
          "recordedAt": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "enum": [
              "provider",
              "manual"
            ]
          },
          "modelProfile": {
            "type": "string",
            "minLength": 1
          },
          "inputTokens": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "outputTokens": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "totalTokens": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        }
      }
    },
    "telemetryProtocol": {
      "const": "p2a.run_telemetry.manual.v1"
    },
    "interruptions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "recordedAt",
          "type",
          "summary",
          "assessment"
        ],
        "additionalProperties": false,
        "properties": {
          "recordedAt": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "enum": [
              "implementation_decision",
              "user_correction",
              "gate_return"
            ]
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "assessment": {
            "enum": [
              "not_applicable",
              "valid",
              "invalid"
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "required": [
                "type"
              ],
              "properties": {
                "type": {
                  "const": "gate_return"
                }
              }
            },
            "then": {
              "properties": {
                "assessment": {
                  "enum": [
                    "valid",
                    "invalid"
                  ]
                }
              }
            },
            "else": {
              "properties": {
                "assessment": {
                  "const": "not_applicable"
                }
              }
            }
          }
        ]
      }
    },
    "visualReview": {
      "type": "object",
      "required": [
        "required",
        "experienceSpecRef",
        "experienceSpecSha256",
        "prototypeManifestRef",
        "prototypeManifestSha256",
        "screenStates",
        "viewports",
        "accessibilityStandard"
      ],
      "additionalProperties": false,
      "properties": {
        "required": {
          "const": true
        },
        "experienceSpecRef": {
          "const": "experience-spec.json"
        },
        "experienceSpecSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "prototypeManifestRef": {
          "type": "string",
          "pattern": "^visual-design/VD-[0-9]+/prototype\\.json$"
        },
        "prototypeManifestSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "screenStates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "screenId",
              "states"
            ],
            "additionalProperties": false,
            "properties": {
              "screenId": {
                "type": "string",
                "pattern": "^SCREEN-[0-9]+$"
              },
              "states": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "viewports": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "name",
              "width",
              "height"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "width": {
                "type": "integer",
                "minimum": 240
              },
              "height": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 240
              }
            }
          }
        },
        "accessibilityStandard": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "acceptanceReview": {
      "type": "object",
      "required": [
        "required",
        "criteria"
      ],
      "additionalProperties": false,
      "properties": {
        "required": {
          "const": true
        },
        "criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "ref",
              "text"
            ],
            "additionalProperties": false,
            "properties": {
              "ref": {
                "type": "string",
                "pattern": "^product\\.(core_flows|success_criteria)\\[[0-9]+\\]$"
              },
              "text": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "visualFeedback": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "reviewedAt",
          "reviewer",
          "verdict",
          "concerns",
          "note"
        ],
        "additionalProperties": false,
        "properties": {
          "reviewedAt": {
            "type": "string",
            "minLength": 1
          },
          "reviewer": {
            "type": "string",
            "minLength": 1
          },
          "verdict": {
            "type": "string",
            "enum": [
              "note",
              "concern"
            ]
          },
          "concerns": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "reproduction": {
      "type": "object",
      "required": [
        "steps",
        "commands",
        "notes"
      ],
      "additionalProperties": false,
      "properties": {
        "steps": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "commands": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "localization": {
      "type": "object",
      "required": [
        "findings",
        "files"
      ],
      "additionalProperties": false,
      "properties": {
        "findings": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "files": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "fixSummary": {
      "type": "object",
      "required": [
        "summaries",
        "files"
      ],
      "additionalProperties": false,
      "properties": {
        "summaries": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "files": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "guard": {
      "type": "object",
      "required": [
        "checks",
        "notes"
      ],
      "additionalProperties": false,
      "properties": {
        "checks": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "failure": {
      "type": "object",
      "required": [
        "class",
        "retryable",
        "needsUserDecision",
        "source"
      ],
      "additionalProperties": false,
      "properties": {
        "class": {
          "type": "string",
          "enum": [
            "verification_failed",
            "test_flake",
            "scope_violation",
            "missing_dependency",
            "environment_failure",
            "implementation_incomplete",
            "other"
          ]
        },
        "retryable": {
          "type": "string",
          "enum": [
            "yes",
            "no",
            "after_fix"
          ]
        },
        "needsUserDecision": {
          "type": "boolean"
        },
        "source": {
          "type": "string",
          "enum": [
            "owner",
            "monitor",
            "implementer"
          ]
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "telemetryProtocol"
        ]
      },
      "then": {
        "required": [
          "usage",
          "interruptions"
        ]
      }
    },
    {
      "if": {
        "required": [
          "acceptanceReview"
        ]
      },
      "then": {
        "required": [
          "runKind"
        ],
        "properties": {
          "runKind": {
            "const": "final_acceptance_review"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "runKind": {
            "const": "final_acceptance_review"
          }
        },
        "required": [
          "runKind"
        ]
      },
      "then": {
        "required": [
          "acceptanceReview"
        ],
        "properties": {
          "changedFiles": {
            "maxItems": 0
          },
          "isolation": {
            "properties": {
              "mode": {
                "const": "none"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "visualReview"
        ]
      },
      "then": {
        "required": [
          "runKind"
        ],
        "properties": {
          "runKind": {
            "const": "final_visual_review"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "runKind": {
            "const": "final_visual_review"
          }
        },
        "required": [
          "runKind"
        ]
      },
      "then": {
        "required": [
          "visualReview"
        ],
        "properties": {
          "changedFiles": {
            "maxItems": 0
          },
          "isolation": {
            "properties": {
              "mode": {
                "const": "none"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": "p2a.run.v2"
          }
        },
        "required": [
          "schema_version"
        ]
      },
      "then": {
        "required": [
          "taskContractSha256"
        ]
      }
    },
