{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plan2agent.local/schemas/reference-bundle-snapshot.schema.json",
  "title": "Plan2Agent Gate A Reference Bundle Snapshot",
  "type": "object",
  "required": [
    "schema_version",
    "source_bundle_ref",
    "source_bundle_sha256",
    "entry_ref",
    "entry_sha256",
    "references"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "p2a.reference_bundle_snapshot.v1" },
    "source_bundle_ref": {
      "type": "string",
      "pattern": "^reference-sources/files/.+"
    },
    "source_bundle_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "entry_ref": {
      "type": "string",
      "pattern": "^reference-sources/files/.+"
    },
    "entry_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "references": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "required": ["id", "path", "kind", "sha256", "load_when", "description"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^REF-[1-9][0-9]*$" },
          "path": {
            "type": "string",
            "pattern": "^reference-sources/files/.+"
          },
          "kind": {
            "enum": [
              "html",
              "test",
              "code",
              "schema",
              "data",
              "image",
              "design",
              "rubric",
              "document",
              "other"
            ]
          },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "load_when": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
