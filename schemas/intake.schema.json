{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plan2agent.local/schemas/intake.schema.json",
  "title": "Plan2Agent Intake Artifact",
  "type": "object",
  "required": [
    "schema_version",
    "idea",
    "summary",
    "known_facts",
    "assumptions",
    "clarifying_questions",
    "needs_user_decision",
    "status",
    "evidence"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "p2a.intake.v1" },
    "idea": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "known_facts": {
      "type": "array",
      "items": { "type": "string" }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "statement", "risk", "confirmation_needed"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^A-[0-9]+$" },
          "statement": { "type": "string", "minLength": 1 },
          "risk": { "type": "string", "enum": ["low", "medium", "high"] },
          "confirmation_needed": { "type": "boolean" }
        }
      }
    },
    "clarifying_questions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "question", "why_it_matters", "blocks"],
        "additionalProperties": true,
        "properties": {
          "id": { "type": "string", "pattern": "^CQ-[0-9]+$" },
          "question": { "type": "string", "minLength": 1 },
          "why_it_matters": { "type": "string", "minLength": 1 },
          "blocks": {
            "type": "array",
            "items": { "type": "string" }
          },
          "status": {
            "type": "string",
            "enum": ["open", "answered", "assumed", "not_applicable"]
          },
          "answer": { "type": "string" }
        }
      }
    },
    "needs_user_decision": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "question", "options", "impact", "default", "status"],
        "additionalProperties": true,
        "properties": {
          "id": { "type": "string", "pattern": "^ND-[0-9]+$" },
          "question": { "type": "string", "minLength": 1 },
          "options": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "required": ["id", "label", "description"],
              "additionalProperties": false,
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "label": { "type": "string", "minLength": 1 },
                "description": { "type": "string", "minLength": 1 }
              }
            }
          },
          "impact": { "type": "string", "minLength": 1 },
          "blocks": {
            "type": "array",
            "items": { "type": "string" }
          },
          "default": { "type": "string", "minLength": 1 },
          "status": { "type": "string", "enum": ["open", "answered", "deferred"] },
          "answer": { "type": "string" }
        }
      }
    },
    "interview": {
      "type": "object",
      "additionalProperties": true
    },
    "approval_audit": {
      "type": "object",
      "required": ["approved_by", "approved_at", "approved_artifacts", "approval_note"],
      "additionalProperties": false,
      "properties": {
        "approved_by": { "type": "string", "minLength": 1 },
        "approved_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}" },
        "approved_artifacts": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "approval_note": { "type": "string", "minLength": 1 }
      }
    },
    "baseline_context": {
      "type": "object",
      "required": ["spec_ref", "reused_answers", "reused_question_dispositions"],
      "additionalProperties": true,
      "properties": {
        "spec_ref": { "type": "string", "minLength": 1 },
        "spec_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "reused_answers": { "type": "array", "items": { "type": "object" } },
        "reused_question_dispositions": { "type": "array", "items": { "type": "object" } }
      }
    },
    "status": {
      "type": "string",
      "enum": ["blocked_on_user", "ready_for_spec"]
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_id", "title", "url", "used_for"],
        "additionalProperties": false,
        "properties": {
          "source_id": { "type": "string", "pattern": "^(WEB|USER|LOCAL)-[0-9]+$" },
          "title": { "type": "string", "minLength": 1 },
          "url": { "type": "string" },
          "used_for": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
