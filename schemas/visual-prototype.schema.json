{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plan2agent.local/schemas/visual-prototype.schema.json",
  "title": "Plan2Agent HTML Visual Prototype Manifest",
  "type": "object",
  "required": [
    "schema_version",
    "project_id",
    "experience_spec_ref",
    "candidate_id",
    "status",
    "entrypoint",
    "screen_states",
    "viewports",
    "network_policy",
    "files"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "p2a.visual_prototype.v1"
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "experience_spec_ref": {
      "const": "../../experience-spec.json"
    },
    "candidate_id": {
      "type": "string",
      "pattern": "^VD-[0-9]+$"
    },
    "status": {
      "type": "string",
      "enum": [
        "candidate",
        "approved"
      ]
    },
    "entrypoint": {
      "type": "string",
      "pattern": "^[^/].*\\.html$"
    },
    "screen_states": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "screen_id",
          "states",
          "state_artifacts"
        ],
        "additionalProperties": false,
        "properties": {
          "screen_id": {
            "type": "string",
            "pattern": "^SCREEN-[0-9]+$"
          },
          "states": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "state_artifacts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "state",
                "artifact_ref"
              ],
              "additionalProperties": false,
              "properties": {
                "state": {
                  "type": "string",
                  "minLength": 1
                },
                "artifact_ref": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    "viewports": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "network_policy": {
      "const": "offline"
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256",
          "media_type"
        ],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "media_type": {
            "type": "string",
            "enum": [
              "text/html",
              "text/css",
              "application/json",
              "image/svg+xml",
              "image/png",
              "image/jpeg",
              "image/webp",
              "font/woff",
              "font/woff2"
            ]
          }
        }
      }
    },
    "approval_audit": {
      "type": "object",
      "required": [
        "approved_by",
        "approved_at",
        "approved_artifacts",
        "approval_note"
      ],
      "additionalProperties": false,
      "properties": {
        "approved_by": {
          "type": "string",
          "minLength": 1
        },
        "approved_at": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}"
        },
        "approved_artifacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "approval_note": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
