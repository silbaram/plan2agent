{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plan2agent.local/schemas/visual-experience.schema.json",
  "title": "Plan2Agent Visual Experience Specification",
  "type": "object",
  "required": [
    "schema_version",
    "project_id",
    "source_spec_ref",
    "mode",
    "visual_direction",
    "design_system",
    "screens",
    "validation",
    "approval"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "p2a.visual_experience.v1"
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "source_spec_ref": {
      "const": "spec.json"
    },
    "mode": {
      "type": "string",
      "enum": [
        "reuse",
        "full"
      ]
    },
    "visual_direction": {
      "type": "object",
      "required": [
        "keywords",
        "references",
        "avoid",
        "candidates",
        "selected_candidate"
      ],
      "additionalProperties": false,
      "properties": {
        "keywords": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "references": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "avoid": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "candidates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "title",
              "summary",
              "tradeoffs",
              "prototype_manifest_ref",
              "prototype_manifest_sha256"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^VD-[0-9]+$"
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "summary": {
                "type": "string",
                "minLength": 1
              },
              "tradeoffs": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "prototype_manifest_ref": {
                "type": "string",
                "pattern": "^visual-design/VD-[0-9]+/prototype\\.json$"
              },
              "prototype_manifest_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        },
        "selected_candidate": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^VD-[0-9]+$"
        }
      }
    },
    "design_system": {
      "type": "object",
      "required": [
        "strategy",
        "references",
        "token_rules",
        "component_rules"
      ],
      "additionalProperties": false,
      "properties": {
        "strategy": {
          "type": "string",
          "enum": [
            "existing",
            "extend",
            "new"
          ]
        },
        "references": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "token_rules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "component_rules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "screens": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "route",
          "user_goal",
          "entry_points",
          "primary_action",
          "secondary_actions",
          "regions",
          "states",
          "success_exit",
          "responsive_rules",
          "accessibility_requirements"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^SCREEN-[0-9]+$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "route": {
            "type": [
              "string",
              "null"
            ]
          },
          "user_goal": {
            "type": "string",
            "minLength": 1
          },
          "entry_points": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "primary_action": {
            "type": "string",
            "minLength": 1
          },
          "secondary_actions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "regions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "id",
                "purpose",
                "priority"
              ],
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "purpose": {
                  "type": "string",
                  "minLength": 1
                },
                "priority": {
                  "type": "string",
                  "enum": [
                    "primary",
                    "secondary",
                    "supporting"
                  ]
                }
              }
            }
          },
          "states": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "success_exit": {
            "type": "string",
            "minLength": 1
          },
          "responsive_rules": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "accessibility_requirements": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "validation": {
      "type": "object",
      "required": [
        "viewports",
        "required_states",
        "accessibility_standard",
        "visual_review_required"
      ],
      "additionalProperties": false,
      "properties": {
        "viewports": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "name",
              "width",
              "height"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "width": {
                "type": "integer",
                "minimum": 240
              },
              "height": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 240
              }
            }
          }
        },
        "required_states": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "accessibility_standard": {
          "type": "string",
          "minLength": 1
        },
        "visual_review_required": {
          "type": "boolean"
        }
      }
    },
    "approval": {
      "type": "string",
      "enum": [
        "draft",
        "approved"
      ]
    },
    "approval_audit": {
      "type": "object",
      "required": [
        "approved_by",
        "approved_at",
        "approved_artifacts",
        "approval_note"
      ],
      "additionalProperties": false,
      "properties": {
        "approved_by": {
          "type": "string",
          "minLength": 1
        },
        "approved_at": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}"
        },
        "approved_artifacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "approval_note": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "const": "full"
          }
        }
      },
      "then": {
        "properties": {
          "visual_direction": {
            "properties": {
              "candidates": {
                "minItems": 2
              }
            }
          },
          "validation": {
            "properties": {
              "visual_review_required": {
                "const": true
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "design_system": {
            "properties": {
              "strategy": {
                "enum": [
                  "existing",
                  "extend"
                ]
              },
              "references": {
                "minItems": 1
              }
            }
          },
          "validation": {
            "properties": {
              "visual_review_required": {
                "const": false
              }
            }
          }
        }
      }
    }
  ]
}
