{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plan2agent.local/schemas/run-index.schema.json",
  "title": "Plan2Agent Agent Run Index",
  "type": "object",
  "required": ["schema_version", "projectId", "runs", "tasks"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "p2a.run_index.v1"},
    "projectId": {"type": "string", "minLength": 1},
    "retrospective": {
      "type": "object",
      "required": ["iterations"],
      "additionalProperties": false,
      "properties": {
        "iterations": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "required": [
              "iterationId",
              "runCount",
              "reasonCounts",
              "statusCounts",
              "verificationCount",
              "verificationDuration",
              "verificationStatusCounts",
              "interruptionCounts"
            ],
            "additionalProperties": false,
            "properties": {
              "iterationId": {"type": ["string", "null"]},
              "runCount": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
              "reasonCounts": {
                "type": "object",
                "required": ["superseded", "completed_maintenance"],
                "additionalProperties": false,
                "properties": {
                  "superseded": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
                  "completed_maintenance": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}
                }
              },
              "statusCounts": {
                "type": "object",
                "required": ["finished", "failed", "blocked"],
                "additionalProperties": false,
                "properties": {
                  "finished": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
                  "failed": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
                  "blocked": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}
                }
              },
              "verificationCount": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
              "verificationDuration": {
                "type": "object",
                "required": ["sampleCount", "totalMs", "maxMs"],
                "additionalProperties": false,
                "properties": {
                  "sampleCount": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
                  "totalMs": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
                  "maxMs": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}
                }
              },
              "verificationStatusCounts": {
                "type": "object",
                "required": ["passed", "failed", "skipped", "not_run", "unavailable"],
                "additionalProperties": false,
                "properties": {
                  "passed": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
                  "failed": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
                  "skipped": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
                  "not_run": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
                  "unavailable": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}
                }
              },
              "interruptionCounts": {
                "type": "object",
                "required": ["implementation_decision", "user_correction", "gate_return_valid", "gate_return_invalid"],
                "additionalProperties": false,
                "properties": {
                  "implementation_decision": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
                  "user_correction": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
                  "gate_return_valid": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
                  "gate_return_invalid": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}
                }
              }
            }
          }
        }
      }
    },
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "runId",
          "taskId",
          "iterationId",
          "status",
          "agentTool",
          "workspaceRef",
          "taskGraphRef",
          "runRef",
          "startedAt",
          "finishedAt"
        ],
        "additionalProperties": false,
        "properties": {
          "runId": {"type": "string", "pattern": "^run-[A-Za-z0-9._-]+$"},
          "taskId": {"type": "string", "pattern": "^task-[0-9]+$"},
          "iterationId": {"type": ["string", "null"]},
          "status": {"type": "string", "enum": ["started", "finished", "failed", "blocked"]},
          "agentTool": {"type": "string", "minLength": 1},
          "workspaceRef": {"type": "string", "minLength": 1},
          "taskGraphRef": {"type": "string", "minLength": 1},
          "runRef": {"type": "string", "minLength": 1},
          "runKind": {
            "type": ["string", "null"],
            "enum": ["final_visual_review", "final_acceptance_review", null]
          },
          "startedAt": {"type": "string", "minLength": 1},
          "finishedAt": {"type": ["string", "null"]}
        }
      }
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["taskId", "runIds", "latestRunId"],
        "additionalProperties": false,
        "properties": {
          "taskId": {"type": "string", "pattern": "^task-[0-9]+$"},
          "runIds": {"type": "array", "items": {"type": "string", "pattern": "^run-[A-Za-z0-9._-]+$"}},
          "latestRunId": {"type": ["string", "null"]}
        }
      }
    }
  }
}
