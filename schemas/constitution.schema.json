{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plan2agent.local/schemas/constitution.schema.json",
  "title": "Plan2Agent Project Constitution",
  "type": "object",
  "required": [
    "schema_version",
    "projectId",
    "architecture",
    "stack",
    "prohibitions",
    "style"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "p2a.constitution.v1" },
    "projectId": { "type": "string", "minLength": 1 },
    "architecture": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": ["id", "rule", "rationale", "scope"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^ARCH-[1-9][0-9]*$" },
          "rule": { "type": "string", "minLength": 1 },
          "rationale": { "type": "string", "minLength": 1 },
          "scope": { "type": "string", "minLength": 1 }
        }
      }
    },
    "stack": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": ["id", "choice", "rationale", "evidence"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^STACK-[1-9][0-9]*$" },
          "choice": { "type": "string", "minLength": 1 },
          "rationale": { "type": "string", "minLength": 1 },
          "evidence": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          }
        }
      }
    },
    "prohibitions": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": ["id", "rule", "rationale"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^NO-[1-9][0-9]*$" },
          "rule": { "type": "string", "minLength": 1 },
          "rationale": { "type": "string", "minLength": 1 },
          "enforcement": {
            "enum": ["validator", "review", "advisory"],
            "default": "advisory"
          },
          "targets": {
            "type": "array",
            "minItems": 1,
            "items": { "enum": ["spec", "task_graph"] },
            "uniqueItems": true
          },
          "forbidden_terms": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          }
        },
        "allOf": [
          {
            "if": {
              "required": ["enforcement"],
              "properties": { "enforcement": { "const": "validator" } }
            },
            "then": { "required": ["targets", "forbidden_terms"] }
          }
        ]
      }
    },
    "style": { "type": "object" },
    "approval_audit": {
      "type": "object",
      "required": [
        "approved_by",
        "approved_at",
        "approved_artifacts",
        "approval_note"
      ],
      "additionalProperties": false,
      "properties": {
        "approved_by": { "const": "user" },
        "approved_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}" },
        "approved_artifacts": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "approval_note": { "type": "string", "minLength": 1 }
      }
    }
  }
}
