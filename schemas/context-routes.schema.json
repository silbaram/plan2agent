{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plan2agent.local/schemas/context-routes.schema.json",
  "title": "Plan2Agent Context Routes",
  "type": "object",
  "required": [
    "schema_version",
    "providers",
    "skills",
    "agents",
    "authorities"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "p2a.context_routes.v1" },
    "providers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["codex", "claude", "gemini"] }
    },
    "skills": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "stages", "gemini_command", "references"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^p2a-[a-z0-9-]+$" },
          "stages": {
            "$ref": "#/$defs/stages"
          },
          "gemini_command": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "modes": { "$ref": "#/$defs/modes" },
          "references": {
            "type": "array",
            "items": { "$ref": "#/$defs/reference" }
          }
        }
      }
    },
    "agents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "skills", "stages", "condition"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^p2a-[a-z0-9-]+$" },
          "skills": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^p2a-[a-z0-9-]+$" }
          },
          "stages": {
            "$ref": "#/$defs/stages"
          },
          "condition": { "type": "string", "minLength": 1 },
          "modes": { "$ref": "#/$defs/modes" }
        }
      }
    },
    "authorities": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/authority" }
    }
  },
  "$defs": {
    "stages": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "entry",
          "gate-a",
          "gate-shape",
          "gate-b",
          "gate-c",
          "execution",
          "visual",
          "acceptance",
          "monitor",
          "closeout"
        ]
      }
    },
    "modes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["direct", "planned", "orchestrated"] }
    },
    "reference": {
      "type": "object",
      "required": ["id", "path", "load", "required", "condition", "phases", "stages"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]+$" },
        "path": { "type": "string", "pattern": "^references/[A-Za-z0-9._/-]+$" },
        "load": { "enum": ["conditional", "on-demand"] },
        "required": { "type": "boolean" },
        "condition": { "type": "string", "minLength": 1 },
        "providers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["codex", "claude", "gemini"] }
        },
        "provider_paths": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/providerPath" }
        },
        "modes": { "$ref": "#/$defs/modes" },
        "phases": { "$ref": "#/$defs/phases" },
        "stages": {
          "$ref": "#/$defs/stages"
        }
      }
    },
    "phases": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "prepare",
          "owner-start",
          "retry",
          "verify-closeout",
          "batch",
          "visual-review",
          "acceptance-review",
          "monitor"
        ]
      }
    },
    "providerPath": {
      "type": "object",
      "required": ["provider", "path"],
      "additionalProperties": false,
      "properties": {
        "provider": { "enum": ["codex", "claude", "gemini"] },
        "path": { "type": "string", "pattern": "^references/[A-Za-z0-9._/-]+$" }
      }
    },
    "authority": {
      "type": "object",
      "required": ["id", "owner", "root", "path", "condition", "stages"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]+$" },
        "owner": { "enum": ["schema", "cli", "hook"] },
        "root": { "enum": ["runtime", "target"] },
        "path": { "type": "string", "pattern": "^[A-Za-z0-9._/-]+$" },
        "condition": { "type": "string", "minLength": 1 },
        "stages": {
          "$ref": "#/$defs/stages"
        },
        "providers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["codex", "claude", "gemini"] }
        },
        "modes": { "$ref": "#/$defs/modes" }
      }
    }
  }
}
