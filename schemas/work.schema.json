{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plan2agent.local/schemas/work.schema.json",
  "title": "Plan2Agent Work State",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "status",
    "goal",
    "scope",
    "non_goals",
    "constraints",
    "approval",
    "tasks",
    "resume"
  ],
  "properties": {
    "schema_version": {
      "const": "p2a.work.v1"
    },
    "id": {
      "type": "string",
      "pattern": "^work-[A-Za-z0-9._-]+$"
    },
    "status": {
      "type": "string",
      "enum": ["draft", "approved", "in_progress", "done"]
    },
    "entry": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "type": "string", "enum": ["idea", "file"] },
        "text": { "type": ["string", "null"] },
        "path": { "type": ["string", "null"] },
        "sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "non_goals": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "constraints": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approved", "at", "quote", "plan_sha256"],
      "properties": {
        "approved": { "type": "boolean" },
        "at": { "type": ["string", "null"] },
        "quote": { "type": ["string", "null"] },
        "plan_sha256": {
          "type": ["string", "null"],
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "status",
          "depends_on",
          "acceptance",
          "verification",
          "changed_files",
          "notes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,31}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": ["todo", "in_progress", "done", "blocked"]
          },
          "depends_on": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "acceptance": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "verification": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "required": [
              "command",
              "status",
              "exit_code",
              "git_head",
              "worktree_fingerprint",
              "at",
              "duration_ms",
              "output_tail"
            ],
            "properties": {
              "command": { "type": "string", "minLength": 1 },
              "status": { "type": "string", "enum": ["passed", "failed"] },
              "exit_code": { "type": ["integer", "null"] },
              "git_head": { "type": ["string", "null"] },
              "worktree_fingerprint": { "type": ["string", "null"] },
              "at": { "type": "string", "minLength": 1 },
              "duration_ms": { "type": "integer", "minimum": 0 },
              "output_tail": { "type": "string" }
            }
          },
          "changed_files": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "notes": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "resume": {
      "type": "object",
      "additionalProperties": false,
      "required": ["active_task_id", "summary", "updated_at"],
      "properties": {
        "active_task_id": { "type": ["string", "null"] },
        "summary": { "type": ["string", "null"] },
        "updated_at": { "type": "string", "minLength": 1 }
      }
    }
  }
}
