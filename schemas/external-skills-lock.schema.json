{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/silbaram/plan2agent/schemas/external-skills-lock.schema.json",
  "title": "Plan2Agent external skills lock",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generatedAt", "upstream", "skills"],
  "properties": {
    "schema_version": { "const": "p2a.external-skills-lock.v1" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "upstream": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package", "version"],
      "properties": {
        "package": { "const": "skills" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" }
      }
    },
    "skills": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
      "additionalProperties": { "$ref": "#/$defs/skill" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "spec", "ref", "resolvedCommit"],
      "properties": {
        "type": { "enum": ["github", "gitlab", "git", "local"] },
        "spec": { "type": "string", "minLength": 1 },
        "ref": { "type": ["string", "null"] },
        "skillPath": { "type": "string", "minLength": 1 },
        "resolvedCommit": { "type": ["string", "null"], "pattern": "^[a-f0-9]{40}$" }
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "bytes"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "bytes": { "type": "integer", "minimum": 0 }
      }
    },
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "description",
        "source",
        "upstreamHash",
        "contentSha256",
        "tools",
        "targets",
        "installedPaths",
        "files"
      ],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "description": { "type": "string", "minLength": 1 },
        "source": { "$ref": "#/$defs/source" },
        "upstreamHash": { "type": ["string", "null"] },
        "contentSha256": { "$ref": "#/$defs/sha256" },
        "tools": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["codex", "claude", "gemini"] }
        },
        "targets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["agents-shared", "claude"] }
        },
        "installedPaths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/file" }
        }
      }
    }
  }
}
