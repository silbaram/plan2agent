{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plan2agent.local/schemas/next.schema.json",
  "title": "Plan2Agent Next Action",
  "type": "object",
  "required": [
    "schema_version",
    "generatedAt",
    "target",
    "projectId",
    "state",
    "reason",
    "command"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "p2a.next.v1" },
    "generatedAt": { "type": "string", "minLength": 1 },
    "target": { "type": "string", "minLength": 1 },
    "projectId": { "type": ["string", "null"] },
    "state": { "type": "string", "minLength": 1 },
    "reason": { "type": "string", "minLength": 1 },
    "command": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "argv", "display"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "cli" },
            "argv": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            },
            "display": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "required": ["kind", "display"],
          "additionalProperties": false,
          "properties": {
            "kind": { "enum": ["skill", "approval"] },
            "display": { "type": "string", "minLength": 1 }
          }
        }
      ]
    }
  }
}
