{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plan2agent.local/schemas/next-v2.schema.json",
  "title": "Plan2Agent Next Action v2",
  "type": "object",
  "required": [
    "schema_version",
    "generatedAt",
    "target",
    "projectId",
    "state",
    "reasonCode",
    "reason",
    "command",
    "continuation"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "p2a.next.v2" },
    "generatedAt": { "type": "string", "minLength": 1 },
    "target": { "type": "string", "minLength": 1 },
    "projectId": { "type": ["string", "null"] },
    "state": { "$ref": "#/$defs/state" },
    "reasonCode": { "$ref": "#/$defs/state" },
    "reason": { "type": "string", "minLength": 1 },
    "command": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "argv", "display", "requiresApproval"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "cli" },
            "requiresApproval": { "type": "boolean" },
            "argv": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            },
            "display": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "required": ["kind", "skill", "args", "display"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "skill" },
            "skill": { "type": "string", "pattern": "^p2a-[a-z0-9-]+$" },
            "args": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            },
            "display": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "required": ["kind", "display"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "approval" },
            "display": { "type": "string", "minLength": 1 },
            "argv": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            },
            "quotePlaceholder": { "const": "<user-utterance>" },
            "decisionSummary": {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "items": { "type": "string", "minLength": 1 },
              "uniqueItems": true
            },
            "options": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "prefixItems": [
                {
                  "type": "object",
                  "required": ["id", "label", "description", "action"],
                  "additionalProperties": false,
                  "properties": {
                    "id": { "const": "review" },
                    "label": { "type": "string", "minLength": 1 },
                    "description": { "type": "string", "minLength": 1 },
                    "action": {
                      "type": "object",
                      "required": ["kind", "display", "remediation"],
                      "additionalProperties": false,
                      "properties": {
                        "kind": { "const": "review" },
                        "display": { "type": "string", "minLength": 1 },
                        "remediation": {
                          "type": "object",
                          "required": ["kind", "argv", "display", "requiresApproval"],
                          "additionalProperties": false,
                          "properties": {
                            "kind": { "const": "cli" },
                            "requiresApproval": { "const": false },
                            "argv": {
                              "type": "array",
                              "minItems": 8,
                              "maxItems": 8,
                              "prefixItems": [
                                { "const": "tasks" },
                                { "const": "todo" },
                                { "const": "--artifacts" },
                                { "type": "string", "minLength": 1 },
                                { "const": "<task-id>" },
                                { "const": "--reopen" },
                                { "const": "--note" },
                                { "const": "<review finding>" }
                              ],
                              "items": false
                            },
                            "display": { "type": "string", "minLength": 1 }
                          }
                        }
                      }
                    }
                  }
                },
                {
                  "type": "object",
                  "required": ["id", "label", "description", "action"],
                  "additionalProperties": false,
                  "properties": {
                    "id": { "const": "retrospective" },
                    "label": { "type": "string", "minLength": 1 },
                    "description": { "type": "string", "minLength": 1 },
                    "action": {
                      "type": "object",
                      "required": ["kind", "display", "report"],
                      "additionalProperties": false,
                      "properties": {
                        "kind": { "const": "retrospective" },
                        "display": { "type": "string", "minLength": 1 },
                        "report": {
                          "type": "object",
                          "required": ["kind", "path", "display", "requiresApproval"],
                          "additionalProperties": false,
                          "properties": {
                            "kind": { "const": "artifact" },
                            "path": { "type": "string", "minLength": 1 },
                            "display": { "type": "string", "minLength": 1 },
                            "requiresApproval": { "const": true }
                          }
                        },
                        "proposalMining": {
                          "type": "object",
                          "required": ["kind", "argv", "display", "requiresApproval"],
                          "additionalProperties": false,
                          "properties": {
                            "kind": { "const": "cli" },
                            "requiresApproval": { "const": true },
                            "argv": {
                              "type": "array",
                              "minItems": 8,
                              "maxItems": 8,
                              "prefixItems": [
                                { "const": "proposals" },
                                { "const": "mine" },
                                { "const": "--artifacts" },
                                { "type": "string", "minLength": 1 },
                                { "const": "--iteration" },
                                { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
                                { "const": "--proposals" },
                                { "type": "string", "minLength": 1 }
                              ],
                              "items": false
                            },
                            "display": { "type": "string", "minLength": 1 }
                          }
                        }
                      }
                    }
                  }
                },
                {
                  "type": "object",
                  "required": ["id", "label", "description", "action"],
                  "additionalProperties": false,
                  "properties": {
                    "id": { "const": "close" },
                    "label": { "type": "string", "minLength": 1 },
                    "description": { "type": "string", "minLength": 1 },
                    "action": {
                      "type": "object",
                      "required": ["kind", "argv", "display", "requiresApproval"],
                      "additionalProperties": false,
                      "properties": {
                        "kind": { "const": "cli" },
                        "requiresApproval": { "const": true },
                        "argv": {
                          "type": "array",
                          "minItems": 4,
                          "maxItems": 4,
                          "prefixItems": [
                            { "const": "iteration" },
                            { "const": "close" },
                            { "const": "--artifacts" },
                            { "type": "string", "minLength": 1 }
                          ],
                          "items": false
                        },
                        "display": { "type": "string", "minLength": 1 }
                      }
                    }
                  }
                }
              ],
              "items": false
            }
          },
          "allOf": [
            {
              "if": { "required": ["argv"] },
              "then": { "required": ["quotePlaceholder", "decisionSummary"] }
            },
            {
              "if": { "required": ["quotePlaceholder"] },
              "then": { "required": ["argv"] }
            }
          ]
        }
      ]
    },
    "continuation": { "$ref": "#/$defs/continuation" },
    "retrospective": {
      "type": "object",
      "required": ["enabled", "candidateCount", "candidates"],
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "candidateCount": { "type": "integer", "minimum": 0, "maximum": 32 },
        "candidates": {
          "type": "array",
          "maxItems": 32,
          "items": { "$ref": "#/$defs/retrospectiveCandidate" }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["state"],
        "properties": {
          "state": { "const": "iteration_review_or_close_required" }
        }
      },
      "then": {
        "required": ["retrospective"],
        "properties": {
          "command": {
            "required": ["options"],
            "properties": {
              "kind": { "const": "approval" }
            }
          },
          "continuation": { "type": "null" }
        }
      },
      "else": {
        "properties": {
          "command": {
            "not": { "required": ["options"] }
          }
        }
      }
    }
  ],
  "$defs": {
    "retrospectiveCandidate": {
      "type": "object",
      "required": [
        "schema_version",
        "candidateId",
        "projectId",
        "iterationId",
        "signal",
        "domain",
        "binding",
        "measurement",
        "counts",
        "targetArea",
        "recommendedChange"
      ],
      "additionalProperties": false,
      "properties": {
        "schema_version": { "const": "p2a.retrospective_candidate.v1" },
        "candidateId": { "type": "string", "pattern": "^retro-[A-Za-z0-9._-]+$" },
        "projectId": { "type": "string", "minLength": 1 },
        "iterationId": { "type": "string", "minLength": 1 },
        "signal": {
          "enum": [
            "performance_regression",
            "slow_verification",
            "retry_overhead",
            "repeated_process_defect",
            "explicit_correction",
            "failed_run",
            "blocked_run",
            "verification_gap",
            "monitor_mismatch"
          ]
        },
        "domain": { "enum": ["product_code", "p2a_process"] },
        "binding": {
          "type": "object",
          "required": ["taskIds", "runIds"],
          "additionalProperties": false,
          "properties": {
            "taskIds": {
              "type": "array",
              "maxItems": 64,
              "items": { "type": "string", "pattern": "^task-[0-9]+$" },
              "uniqueItems": true
            },
            "runIds": {
              "type": "array",
              "maxItems": 64,
              "items": { "type": "string", "pattern": "^run-[A-Za-z0-9._-]+$" },
              "uniqueItems": true
            }
          }
        },
        "measurement": {
          "type": "object",
          "required": ["category", "unit", "baseline", "budget", "observed", "delta", "threshold"],
          "additionalProperties": false,
          "properties": {
            "category": {
              "enum": [
                "test",
                "lint",
                "typecheck",
                "custom",
                "retry_attempts",
                "failure_pattern",
                "interruption_pattern",
                "run_status",
                "monitor_verdict"
              ]
            },
            "unit": { "enum": ["milliseconds", "count"] },
            "baseline": { "type": ["integer", "null"], "minimum": 0, "maximum": 9007199254740991 },
            "budget": { "type": ["integer", "null"], "minimum": 0, "maximum": 9007199254740991 },
            "observed": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
            "delta": { "type": ["integer", "null"], "minimum": -9007199254740991, "maximum": 9007199254740991 },
            "threshold": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }
          }
        },
        "counts": {
          "type": "object",
          "required": ["runs", "retries", "failed", "blocked", "interruptions"],
          "additionalProperties": false,
          "properties": {
            "runs": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
            "retries": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
            "failed": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
            "blocked": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
            "interruptions": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
          }
        },
        "targetArea": { "enum": ["product_verification", "execution_process"] },
        "recommendedChange": { "type": "string", "minLength": 1, "maxLength": 240 }
      }
    },
    "state": {
      "enum": [
        "uninitialized",
        "entry_invalid",
        "entry_deferred",
        "blocked_scope_replacement_ready",
        "gate_what",
        "entry_missing",
        "incomplete_iteration_layout",
        "current_development_contract_required",
        "invalid_current_development_contract",
        "invalid_iteration_state",
        "invalid_decisions",
        "invalid_gate_a",
        "invalid_constitution",
        "shape",
        "gate_a_ready_for_spec",
        "gate_a_needs_approval",
        "invalid_gate_b",
        "started_run_contract_drift",
        "gate_b_needs_decisions",
        "gate_b_needs_approval",
        "gate_b_approved_needs_spec_promotion",
        "gate_b_approved_needs_execution_prepare",
        "gate_b_approved_needs_tasks",
        "invalid_gate_c",
        "gate_c_validated_needs_iteration_init",
        "invalid_run_evidence",
        "run_started",
        "ready_task_available",
        "tasks_blocked",
        "final_visual_review_required",
        "final_acceptance_review_required",
        "relevant_verification_required",
        "final_verification_required",
        "iteration_review_or_close_required",
        "flat_execution_complete",
        "run_evidence_needs_proposal_mining",
        "iteration_composition_required",
        "iteration_complete",
        "project_selection_required",
        "state_needs_inspection"
      ]
    },
    "phase": {
      "enum": [
        "prepare",
        "owner-start",
        "retry",
        "verify-closeout",
        "batch",
        "visual-review",
        "acceptance-review",
        "monitor"
      ]
    },
    "continuation": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["id", "activation", "sourceState", "skill", "phase", "mode"],
          "additionalProperties": false,
          "properties": {
            "id": {
              "enum": [
                "execution.prepare",
                "execution.owner-start",
                "execution.visual-review",
                "execution.acceptance-review"
              ]
            },
            "activation": { "enum": ["immediate", "after_command_success", "run_declared"] },
            "sourceState": { "$ref": "#/$defs/state" },
            "skill": { "const": "p2a-dev-execution" },
            "phase": { "$ref": "#/$defs/phase" },
            "mode": {
              "type": ["string", "null"],
              "enum": ["direct", "planned", null]
            },
            "binding": {
              "type": "object",
              "required": ["kind", "schema_version", "field"],
              "additionalProperties": false,
              "properties": {
                "kind": { "const": "command_result" },
                "schema_version": { "const": "p2a.execution_result.v1" },
                "field": { "const": "runId" }
              }
            }
          },
          "allOf": [
            {
              "if": {
                "required": ["activation"],
                "properties": { "activation": { "const": "after_command_success" } }
              },
              "then": { "required": ["binding"] }
            },
            {
              "if": {
                "required": ["activation"],
                "properties": { "activation": { "enum": ["immediate", "run_declared"] } }
              },
              "then": { "not": { "required": ["binding"] } }
            },
            {
              "oneOf": [
                {
                  "properties": {
                    "id": { "const": "execution.prepare" },
                    "activation": { "const": "immediate" },
                    "phase": { "const": "prepare" },
                    "mode": { "type": "null" }
                  }
                },
                {
                  "properties": {
                    "id": { "const": "execution.owner-start" },
                    "activation": { "const": "after_command_success" },
                    "phase": { "const": "owner-start" },
                    "mode": { "enum": ["direct", "planned"] }
                  }
                },
                {
                  "properties": {
                    "id": { "const": "execution.visual-review" },
                    "activation": { "const": "after_command_success" },
                    "phase": { "const": "visual-review" },
                    "mode": { "enum": ["direct", "planned"] }
                  }
                },
                {
                  "properties": {
                    "id": { "const": "execution.acceptance-review" },
                    "activation": { "const": "after_command_success" },
                    "phase": { "const": "acceptance-review" },
                    "mode": { "enum": ["direct", "planned"] }
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  }
}
