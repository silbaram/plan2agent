{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plan2agent.local/schemas/config.schema.json",
  "title": "Plan2Agent Project Config",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "verify"
  ],
  "properties": {
    "schema_version": {
      "const": "p2a.config.v1"
    },
    "project_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "tools": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["codex", "claude", "gemini"]
      }
    },
    "verify": {
      "type": "object",
      "additionalProperties": false,
      "required": ["test", "lint", "typecheck"],
      "properties": {
        "test": { "type": ["string", "null"] },
        "lint": { "type": ["string", "null"] },
        "typecheck": { "type": ["string", "null"] },
        "timeout_ms": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 600000
        }
      }
    },
    "buildlore": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" },
        "command": { "type": "string", "minLength": 1 },
        "command_args": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
