{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plan2agent.local/schemas/acceptance-review.schema.json",
  "title": "Plan2Agent Functional Acceptance Review",
  "type": "object",
  "required": [
    "schema_version",
    "iteration_id",
    "source_spec_ref",
    "cases",
    "verdict",
    "unmet"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "p2a.acceptance_review.v1"
    },
    "iteration_id": {
      "type": "string",
      "minLength": 1
    },
    "source_spec_ref": {
      "type": "string",
      "minLength": 1
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "criterion_ref",
          "command",
          "source",
          "exitCode",
          "stdoutTail",
          "verdict"
        ],
        "additionalProperties": false,
        "properties": {
          "criterion_ref": {
            "type": "string",
            "pattern": "^product\\.(core_flows|success_criteria)\\[[0-9]+\\]$"
          },
          "command": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "enum": [
              "command",
              "config"
            ]
          },
          "exitCode": {
            "type": "integer"
          },
          "stdoutTail": {
            "type": "string"
          },
          "verdict": {
            "type": "string",
            "enum": [
              "pass",
              "fail"
            ]
          }
        }
      }
    },
    "verdict": {
      "type": "string",
      "enum": [
        "confirm_behavior",
        "block"
      ]
    },
    "unmet": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
