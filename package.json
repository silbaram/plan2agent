{
  "name": "plan2agent",
  "version": "1.0.0",
  "description": "Minimal task and session-resume development harness for AI coding agents.",
  "license": "MIT",
  "keywords": [
    "ai-coding-agent",
    "development-harness",
    "task-tracking",
    "session-resume",
    "human-in-the-loop",
    "claude-code",
    "codex",
    "gemini-cli",
    "cli"
  ],
  "type": "module",
  "bin": {
    "p2a": "scripts/p2a.mjs"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "files": [
    "scripts",
    "schemas",
    ".agents",
    ".claude",
    ".codex",
    ".gemini"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/silbaram/plan2agent.git"
  },
  "homepage": "https://github.com/silbaram/plan2agent#readme",
  "bugs": {
    "url": "https://github.com/silbaram/plan2agent/issues"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check:parity": "node scripts/check_cli_parity.mjs",
    "sync:assets": "node scripts/sync_cli_assets.mjs",
    "test:all": "npm test && npm run check:parity"
  }
}
