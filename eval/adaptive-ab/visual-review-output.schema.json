{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["verdict", "drift_count", "note"],
  "additionalProperties": false,
  "properties": {
    "verdict": {"type": "string", "enum": ["pass", "fail"]},
    "drift_count": {"type": "integer", "minimum": 0},
    "note": {"type": "string"}
  }
}
